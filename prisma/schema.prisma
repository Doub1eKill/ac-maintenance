// This schema was introspected from the live MySQL database (via `prisma db pull`)
// that was previously managed by Laravel migrations — every relation, index, and
// onDelete/onUpdate behavior below was cross-checked against the actual FK
// constraints in information_schema.REFERENTIAL_CONSTRAINTS and matches exactly.
// Reasoning comments are carried over from the original Laravel migrations so the
// "why" isn't lost in the framework migration. The leftover Laravel framework
// tables (cache, jobs, sessions, …) were dropped in commit 5b97552.
//
// The system was originally built multi-tenant, with a University at the root of
// the Building/Room/AirConditioner tree and a super_admin role above the tenant
// admins. It now serves a single institution, so that layer is gone: there is no
// University model, no university_id columns, and no super_admin role. Scoping a
// query to "this organisation" is no longer something the application has to do —
// every row in the database already belongs to it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Building {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name         String    @unique(map: "buildings_name_unique") @db.VarChar(255)
  abbreviation String    @unique(map: "buildings_abbreviation_unique") @db.VarChar(10) // feeds ac_code's first segment, e.g. "B1"
  createdAt    DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  // Buildings sit at the root now that University is gone. Name and
  // abbreviation used to be unique per tenant; with one institution left,
  // uniqueness is simply global.
  rooms Room[]

  @@map("buildings")
}

model Room {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  buildingId BigInt    @map("building_id") @db.UnsignedBigInt
  name       String    @db.VarChar(255) // room number/label, e.g. "301"
  floor      Int?      @db.UnsignedSmallInt
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  // 1:N — one building has many rooms.
  // RESTRICT: force explicit room reassignment before a building can be removed.
  building        Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "rooms_building_id_foreign")
  airConditioners AirConditioner[]

  @@unique([buildingId, name], map: "rooms_building_id_name_unique")
  @@map("rooms")
}

model User {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  role            UserRole   @default(technician)
  status          UserStatus @default(pending) // separate from role — an account can be a valid technician and still be pending/suspended
  name            String     @db.VarChar(255)
  email           String     @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamp(0)
  // Nullable on purpose (was NOT NULL under Laravel): NULL doubles as the
  // "must reset password" flag instead of a separate boolean column. Every
  // legacy Laravel bcrypt hash is deliberately cleared to NULL during this
  // migration (bcrypt hashes from Laravel's password broker cannot be
  // verified through this app's own hashing calls without dragging the old
  // PHP-specific bcrypt config along), so NULL means one thing consistently:
  // this account cannot sign in via Credentials until a new password is set.
  password        String?    @db.VarChar(255)
  // Path under /uploads to the profile picture, written by saveUpload(). NULL
  // means the account has never set one — the UI falls back to the user's
  // initials, so this is a real state rather than missing data.
  avatarUrl       String?    @map("avatar_url") @db.VarChar(255)
  rememberToken   String?    @map("remember_token") @db.VarChar(100)
  createdAt       DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?  @map("updated_at") @db.Timestamp(0)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamp(0)

  phones            UserPhone[]
  maintenanceLogs   MaintenanceLog[]
  claimedWorkOrders WorkOrder[]      @relation("work_orders_claimed_by")
  reportedWorkOrders WorkOrder[]     @relation("work_orders_reported_by")
  assignedWorkOrders WorkOrder[]     @relation("work_orders_assigned_to")
  systemAuditLogs   SystemAuditLog[]

  // Replaces the two tenant-prefixed indexes this table used to carry. The
  // one query that filters users looks for active technicians, so a single
  // composite over exactly that pair covers it — and one index costs less on
  // write than the two it replaces.
  @@index([role, status], map: "users_role_status_index")
  @@map("users")
}

model UserPhone {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  phoneNumber String    @map("phone_number") @db.VarChar(255)
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  // 1NF fix: a user can have multiple phone numbers, so they get their own
  // table instead of phone_1/phone_2 columns.
  // CASCADE: a phone number has no meaning without its owner.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_phones_user_id_foreign")

  @@unique([userId, phoneNumber], map: "user_phones_user_id_phone_number_unique")
  @@map("user_phones")
}

model AcBrand {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @unique(map: "ac_brands_name_unique") @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)
  // Soft delete, same as air_conditioners.deleted_at: a unit that still uses a
  // retired brand keeps showing its name and its history stays readable. Note
  // the name stays in ac_brands_name_unique while it sits in the trash, so
  // re-creating a deleted brand is a restore, not an insert.
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)

  models          AcModel[]
  airConditioners AirConditioner[]

  @@map("ac_brands")
}

model AcModel {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  brandId    BigInt    @map("brand_id") @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  defaultBtu Int?      @map("default_btu") @db.UnsignedInt
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)
  // Soft delete. Independent of the brand's own deleted_at: deleting a brand
  // does not stamp its models, the selection queries just filter on both. That
  // way restoring a brand brings back exactly the models that were still live
  // when it was retired, instead of resurrecting ones deleted before it.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamp(0)

  brand           AcBrand          @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ac_models_brand_id_foreign")
  airConditioners AirConditioner[]

  @@unique([brandId, name], map: "ac_models_brand_id_name_unique")
  @@map("ac_models")
}

model AirConditioner {
  id          BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  roomId      BigInt               @map("room_id") @db.UnsignedBigInt
  acBrandId   BigInt?              @map("ac_brand_id") @db.UnsignedBigInt
  acModelId   BigInt?              @map("ac_model_id") @db.UnsignedBigInt
  acCode      String               @unique(map: "air_conditioners_ac_code_unique") @map("ac_code") @db.VarChar(255) // human-readable, globally unique: [BLDG]-[ROOM]-[NN] (the [UNI] segment went away with multi-tenancy)
  qrCode      String               @unique(map: "air_conditioners_qr_code_unique") @map("qr_code") @db.Char(36) // uuid embedded in the printed QR — never exposes the sequential ac_code
  brand       String?              @db.VarChar(255) // Fallback for "Other" custom brands
  model       String?              @db.VarChar(255) // Fallback for "Other" custom models
  btu         Int?                 @db.UnsignedInt
  installedAt DateTime?            @map("installed_at") @db.Date
  status      AirConditionerStatus @default(normal)
  createdAt   DateTime?            @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?            @map("updated_at") @db.Timestamp(0)
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamp(0)

  // 1:N — one room can contain several units. RESTRICT: force explicit
  // reassignment/retirement of units before a room is removed.
  // roomId is immutable in the app layer after registration (never exposed
  // as editable) — this is what makes denormalizing tenant info onto
  // work_orders safe (see WorkOrder below): there's no window where a
  // unit's tenant chain could go stale.
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "air_conditioners_room_id_foreign")
  acBrand         AcBrand?         @relation(fields: [acBrandId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "airConditioners_ac_brand_id_foreign")
  acModel         AcModel?         @relation(fields: [acModelId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "airConditioners_ac_model_id_foreign")
  maintenanceLogs MaintenanceLog[]
  workOrders      WorkOrder[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([roomId], map: "air_conditioners_room_id_index")
  @@map("air_conditioners")
}

model MaintenanceLog {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  airConditionerId BigInt            @map("air_conditioner_id") @db.UnsignedBigInt
  workOrderId      BigInt?           @map("work_order_id") @db.UnsignedBigInt // set only when this log closes a claimed pool job
  userId           BigInt            @map("user_id") @db.UnsignedBigInt // the technician who performed the work
  action           MaintenanceAction
  notes            String?           @db.Text
  // What was actually repaired. Kept apart from `notes` (which is a free
  // remark about the visit as a whole) so repair work can be searched and
  // reported on without parsing prose. Only ever set on rows whose action is
  // `repair` — a visit that also cleaned the unit writes a separate row, and
  // that row has nothing to say here.
  repairDetail     String?           @map("repair_detail") @db.Text
  beforePhotoUrl       String?       @map("before_photo_url") @db.VarChar(255)
  afterPhotoUrl        String?       @map("after_photo_url") @db.VarChar(255)
  customerSignatureUrl String?       @map("customer_signature_url") @db.VarChar(255)
  performedAt      DateTime          @map("performed_at") @db.DateTime(0)
  createdAt        DateTime?         @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?         @map("updated_at") @db.Timestamp(0)

  // Central transaction table. Never CASCADE on either FK below: a
  // physical asset's repair history, and a technician's accountability for
  // work performed, must both survive independently of the referenced
  // row's own lifecycle.
  airConditioner AirConditioner @relation(fields: [airConditionerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "maintenance_logs_air_conditioner_id_foreign")
  technician     User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "maintenance_logs_user_id_foreign")
  // SET NULL: the log has independent value as history — it must survive
  // even if the work order itself is later deleted or cancelled.
  workOrder      WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "maintenance_logs_work_order_id_foreign")

  @@index([airConditionerId, performedAt], map: "maintenance_logs_air_conditioner_id_performed_at_index")
  @@index([userId], map: "maintenance_logs_user_id_index")
  @@index([workOrderId], map: "maintenance_logs_work_order_id_index")
  @@map("maintenance_logs")
}

model WorkOrder {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  airConditionerId BigInt          @map("air_conditioner_id") @db.UnsignedBigInt
  status           WorkOrderStatus @default(pending)
  // What the job is for, recorded when the order is raised. It used to be
  // inferred from the unit's current condition, which was wrong in two
  // directions: a broken unit that came due for cleaning read as a repair,
  // and once a job closed and the unit went back to normal, the type shown
  // against its own history changed with it. Deliberately has no default —
  // every caller that opens a work order has to say which kind it is.
  type             WorkOrderType
  priority         String?         @default("low") @db.VarChar(20)
  issueDescription String?         @map("issue_description") @db.Text
  resolutionNotes  String?         @map("resolution_notes") @db.Text
  images           Json?           @default("[]")
  reportedById     BigInt?         @map("reported_by_id") @db.UnsignedBigInt
  assignedToId     BigInt?         @map("assigned_to_id") @db.UnsignedBigInt
  assignedAt       DateTime?       @map("assigned_at") @db.Timestamp(0)
  claimedBy        BigInt?         @map("claimed_by") @db.UnsignedBigInt
  claimedAt        DateTime?       @map("claimed_at") @db.Timestamp(0) // separate from updatedAt, which gets overwritten again on completion
  completedAt      DateTime?       @map("completed_at") @db.Timestamp(0)
  // Was nullable with no default, so every caller had to remember to set it
  // themselves -- none did, leaving every existing row NULL and "วันที่แจ้ง"
  // blank across the board and detail dialog. A DB-level default closes that
  // off structurally instead of relying on each call site.
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?       @map("updated_at") @db.Timestamp(0)

  // RESTRICT: semi-transactional table, never cascade.
  airConditioner  AirConditioner   @relation(fields: [airConditionerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "work_orders_air_conditioner_id_foreign")
  // SET NULL: optional reference — nullable until claimed. This app never
  // hard-deletes users (accounts are suspended via User.status instead),
  // so this is a safety net more than an expected path.
  reportedByUser  User?            @relation("work_orders_reported_by", fields: [reportedById], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "work_orders_reported_by_foreign")
  assignedToUser  User?            @relation("work_orders_assigned_to", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "work_orders_assigned_to_foreign")
  claimedByUser   User?            @relation("work_orders_claimed_by", fields: [claimedBy], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "work_orders_claimed_by_foreign")
  maintenanceLogs MaintenanceLog[]

  // The pool page reads pending orders newest-first on every dashboard load;
  // this is the same index as before minus its now-meaningless tenant prefix.
  @@index([status, createdAt], map: "work_orders_status_created_at_index")
  @@index([airConditionerId, status], map: "work_orders_air_conditioner_id_status_index")
  @@index([claimedBy], map: "work_orders_claimed_by_index")
  @@map("work_orders")
}

model SystemAuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  action       String   @db.VarChar(100)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     BigInt   @map("entity_id") @db.UnsignedBigInt
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_user_fk")

  @@index([entityType, entityId], map: "audit_entity_idx")
  @@map("system_audit_logs")
}

model MaintenanceSchedule {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  airConditionerId BigInt   @map("air_conditioner_id") @db.UnsignedBigInt
  frequencyMonths  Int?     @map("frequency_months") @db.UnsignedSmallInt // Legacy
  frequencyValue   Int      @default(6) @map("frequency_value") @db.UnsignedInt
  frequencyUnit    String   @default("months") @map("frequency_unit") @db.VarChar(20) // "days", "months", "years"
  lastPerformedAt  DateTime? @map("last_performed_at") @db.Date
  nextDueDate      DateTime @map("next_due_date") @db.Date
  isActive         Boolean  @default(true) @map("is_active")

  airConditioner   AirConditioner @relation(fields: [airConditionerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "schedule_ac_fk")

  @@index([nextDueDate], map: "schedule_due_date_idx")
  @@map("maintenance_schedules")
}

/// Settings that belong to the installation as a whole rather than to any
/// row in it. Deliberately a single row, pinned to id = 1 and created by the
/// migration that adds this table, so readers never have to handle "not
/// configured yet" as a separate state — there is always exactly one row to
/// read, and writers upsert against that id.
model SystemSettings {
  id Int @id @default(1)

  // Applied to air conditioners registered from here on. Existing units keep
  // whatever cycle they were given; changing this never rewrites them.
  defaultFrequencyValue Int    @default(6) @map("default_frequency_value") @db.UnsignedInt
  defaultFrequencyUnit  String @default("months") @map("default_frequency_unit") @db.VarChar(20)

  // Replaces the ORGANISATION_NAME constant that stood in for the University
  // row after F1 removed it. Nullable: unset means "fall back to the built-in
  // name" rather than "display nothing".
  organisationName    String? @map("organisation_name") @db.VarChar(255)
  organisationAddress String? @map("organisation_address") @db.VarChar(255)
  organisationPhone   String? @map("organisation_phone") @db.VarChar(255)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("system_settings")
}

enum UserRole {
  // org_admin keeps its name despite there being only one organisation now —
  // renaming it would touch every role check, session type and seeded row for
  // no behavioural gain.
  org_admin
  technician

  @@map("users_role")
}

enum UserStatus {
  pending
  active
  suspended

  @@map("users_status")
}

enum WorkOrderType {
  repair
  cleaning

  @@map("work_orders_type")
}

enum WorkOrderStatus {
  pending
  claimed
  completed
  cancelled

  @@map("work_orders_status")
}

enum MaintenanceAction {
  cleaning
  repair
  refill_refrigerant

  @@map("maintenance_logs_action")
}

enum AirConditionerStatus {
  normal
  broken
  needs_cleaning

  @@map("air_conditioners_status")
}
